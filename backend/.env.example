# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# A random 256-bit hex string.  Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-random-256-bit-hex

DEMO_USERNAME=demo
DEMO_PASSWORD=change-me

# Paste the full contents of keys/private_key.pem here (newlines as \n)
RSA_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Paste the full contents of keys/public_key.pem here (newlines as \n)
RSA_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# JSON array of allowed frontend origins
CORS_ORIGINS=["https://your-github-username.github.io","http://localhost:3000","http://127.0.0.1:3000"]

# Optional: Google Places API (New) key — enables supplementary search when OSM data is sparse.
# Leave empty to run Nominatim-only mode.
# Setup: console.cloud.google.com → enable "Places API (New)" → create API key
GOOGLE_MAPS_API_KEY=
